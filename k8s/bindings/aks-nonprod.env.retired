# First real (non-kind) target. Two placeholders below need your input:
#
# IMAGE_REPO — must be the actual GHCR path build-image.yml pushed to,
# not the bare local name. Check the "Image summary" step output on a
# build-image.yml run for the exact value (it's ${{ github.repository }},
# i.e. <owner>/demo-kubernetes-krane — NOT demo-kubernetes-krane-app).
#
# NAMESPACE — must already exist on the cluster before krane can deploy
# to it (krane has no --create-namespace flag). Confirm/create it first:
#   kubectl create namespace app-nonprod --dry-run=client -o yaml | kubectl apply -f -
APP_NAME=demo-app
IMAGE_REPO=ghcr.io/creid-octopus/demo-kubernetes-krane
NAMESPACE=app-nonprod
ENVIRONMENT=nonprod
REGION=aks-nonprod
REPLICAS_WEB=1
REPLICAS_WORKER=1
CPU_REQUEST=100m
MEM_REQUEST=128Mi
CPU_LIMIT=250m
MEM_LIMIT=256Mi
PDB_MIN_AVAILABLE=0
LOG_LEVEL=info
