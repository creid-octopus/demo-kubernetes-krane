# Second real cluster. IMAGE_REPO carries over from aks-nonprod.env since
# both clusters pull the same image from the same shared registry — only
# NAMESPACE/REGION/sizing change per cluster.
#
# NAMESPACE — confirm it exists on this cluster before krane can deploy to
# it (krane has no --create-namespace flag):
#   kubectl create namespace app-production --dry-run=client -o yaml | kubectl apply -f -
APP_NAME=demo-app
IMAGE_REPO=ghcr.io/creid-octopus/demo-kubernetes-krane
NAMESPACE=app-production
ENVIRONMENT=production
REGION=aks-production
REPLICAS_WEB=2
REPLICAS_WORKER=1
CPU_REQUEST=100m
MEM_REQUEST=128Mi
CPU_LIMIT=250m
MEM_LIMIT=256Mi
PDB_MIN_AVAILABLE=1
LOG_LEVEL=info
