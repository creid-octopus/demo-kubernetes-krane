# One of two namespaces on the aks-nonprod cluster (see aks-nonprod-test.env
# for the other). Same cluster, same image, separate namespace per purpose.
#
# NAMESPACE — confirm it exists on this cluster before krane can deploy to
# it (krane has no --create-namespace flag):
#   kubectl create namespace app-dev --dry-run=client -o yaml | kubectl apply -f -
APP_NAME=demo-app
IMAGE_REPO=ghcr.io/creid-octopus/demo-kubernetes-krane
NAMESPACE=app-dev
ENVIRONMENT=dev
REGION=aks-nonprod-dev
REPLICAS_WEB=1
REPLICAS_WORKER=1
CPU_REQUEST=100m
MEM_REQUEST=128Mi
CPU_LIMIT=250m
MEM_LIMIT=256Mi
PDB_MIN_AVAILABLE=0
LOG_LEVEL=info
