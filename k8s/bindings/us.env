# "US region" — today this is just a namespace on the same local kind
# cluster (see scripts/regions.conf). Swap the matching context in
# regions.conf to point this at a real cluster later; this file doesn't
# need to change.
APP_NAME=demo-app
IMAGE_REPO=demo-kubernetes-krane-app
NAMESPACE=app-us
ENVIRONMENT=production
REGION=us
REPLICAS_WEB=2
REPLICAS_WORKER=1
CPU_REQUEST=100m
MEM_REQUEST=128Mi
CPU_LIMIT=250m
MEM_LIMIT=256Mi
PDB_MIN_AVAILABLE=1
LOG_LEVEL=info
