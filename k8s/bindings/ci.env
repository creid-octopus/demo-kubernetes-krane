# Used only by the ephemeral kind smoke-deploy in .github/workflows/ci.yml.
# Separate namespace so CI runs never collide with local dev.
APP_NAME=demo-app
IMAGE_REPO=demo-kubernetes-krane-app
NAMESPACE=app-ci
ENVIRONMENT=ci
REGION=ci
REPLICAS_WEB=1
REPLICAS_WORKER=1
CPU_REQUEST=50m
MEM_REQUEST=64Mi
CPU_LIMIT=200m
MEM_LIMIT=128Mi
PDB_MIN_AVAILABLE=0
LOG_LEVEL=debug
