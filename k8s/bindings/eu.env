# "EU region" — same idea as us.env, different namespace. Add more .env
# files the same way to model additional regions.
APP_NAME=demo-app
IMAGE_REPO=demo-kubernetes-krane-app
NAMESPACE=app-eu
ENVIRONMENT=production
REGION=eu
REPLICAS_WEB=2
REPLICAS_WORKER=1
CPU_REQUEST=100m
MEM_REQUEST=128Mi
CPU_LIMIT=250m
MEM_LIMIT=256Mi
PDB_MIN_AVAILABLE=1
LOG_LEVEL=info
