# Sourced by scripts/deploy.sh before `krane render`. Keys become ENV vars
# the templates read via ENV['X'] / ENV.fetch('X') — the same mechanism
# used for REVISION, just extended to cover everything else that varies
# per environment/region.
APP_NAME=demo-app
IMAGE_REPO=demo-kubernetes-krane-app
NAMESPACE=app-development
ENVIRONMENT=development
REGION=local
REPLICAS_WEB=1
REPLICAS_WORKER=1
CPU_REQUEST=50m
MEM_REQUEST=64Mi
CPU_LIMIT=200m
MEM_LIMIT=128Mi
PDB_MIN_AVAILABLE=0
LOG_LEVEL=debug
